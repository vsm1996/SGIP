generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model User {
  id                String           @id @default(cuid())
  firstName         String?
  lastName          String?
  name              String?
  username          String?          @unique
  email             String?          @unique
  emailVerified     DateTime?
  hashedPassword    String?
  image             String?
  createdAt         DateTime         @default(now())
  accounts          Account[]
  bookmarks         Bookmark[]
  comments          Comment[]
  commentsReplies   CommentReply[]
  discussions       Discussion[]
  createdRooms      DiscussionRoom[] @relation("CreatedRooms")
  likes             Like[]
  mentionsReceived  Mention[]        @relation("mentionedUser")
  mentionsSent      Mention[]        @relation("mentionAuthor")
  notifications     Notification[]
  posts             Post[]
  reactions         Reaction[]
  sessions          Session[]
  participatedRooms DiscussionRoom[] @relation("RoomParticipants")
  messages          Message[]
}

model Discussion {
  id        String     @id @default(uuid())
  title     String     @db.Text
  content   String     @db.Text
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bookmarks Bookmark[]
  comments  Comment[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     Like[]
  mentions  Mention[]
  reactions Reaction[]

  @@index([userId], map: "Discussion_userId_fkey")
}

model Post {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  message      String         @db.Text
  content      String?        @db.Text
  isRichText   Boolean        @default(false)
  userId       String
  sessionId    String?
  comments     Comment[]
  likes        Like[]
  mentions     Mention[]
  reactions    Reaction[]
  bookmarks    Bookmark[]
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Post_userId_fkey")
}

model Comment {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  message        String         @db.Text
  userId         String
  postId         String
  discussionId   String?
  discussion     Discussion?    @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  post           Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentReplies CommentReply[]
  likes          Like[]
  mentions       Mention[]
  reactions      Reaction[]     @relation("CommentReactions")

  @@index([discussionId], map: "Comment_discussionId_fkey")
  @@index([postId], map: "Comment_postId_fkey")
  @@index([userId], map: "Comment_userId_fkey")
}

model CommentReply {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  message   String    @db.Text
  userId    String
  commentId String?
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     Like[]
  mentions  Mention[]
  reactions Reaction[] @relation("CommentReplyReactions")

  @@index([commentId], map: "CommentReply_commentId_fkey")
  @@index([userId], map: "CommentReply_userId_fkey")
}

model Like {
  id             String        @id @default(cuid())
  userId         String
  discussionId   String?
  postId         String?
  commentId      String?
  commentReplyId String?
  comment        Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentReply   CommentReply? @relation(fields: [commentReplyId], references: [id], onDelete: Cascade)
  discussion     Discussion?   @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  post           Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId], map: "Like_commentId_fkey")
  @@index([commentReplyId], map: "Like_commentReplyId_fkey")
  @@index([discussionId], map: "Like_discussionId_fkey")
  @@index([postId], map: "Like_postId_fkey")
  @@index([userId], map: "Like_userId_fkey")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Notification_userId_fkey")
}

model Mention {
  id              String        @id @default(uuid())
  userId          String
  mentionedUserId String
  discussionId    String?
  postId          String?
  commentId       String?
  commentReplyId  String?
  unread          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  comment         Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentReply    CommentReply? @relation(fields: [commentReplyId], references: [id], onDelete: Cascade)
  discussion      Discussion?   @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  mentionedUser   User          @relation("mentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  post            Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User          @relation("mentionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId], map: "Mention_commentId_fkey")
  @@index([commentReplyId], map: "Mention_commentReplyId_fkey")
  @@index([discussionId], map: "Mention_discussionId_fkey")
  @@index([mentionedUserId], map: "Mention_mentionedUserId_fkey")
  @@index([postId], map: "Mention_postId_fkey")
  @@index([userId], map: "Mention_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Reaction {
  id             String        @id @default(cuid())
  type           String        @default("LIKE")
  userId         String
  postId         String?
  commentId      String?
  commentReplyId String?
  discussionId   String?
  createdAt      DateTime      @default(now())
  comment        Comment?      @relation("CommentReactions", fields: [commentId], references: [id], onDelete: Cascade)
  commentReply   CommentReply? @relation("CommentReplyReactions", fields: [commentReplyId], references: [id], onDelete: Cascade)
  discussion     Discussion?   @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  post           Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Reaction_userId_fkey")
  @@index([postId], map: "Reaction_postId_fkey")
  @@index([commentId], map: "Reaction_commentId_fkey")
  @@index([commentReplyId], map: "Reaction_commentReplyId_fkey")
  @@index([discussionId], map: "Reaction_discussionId_fkey")
}

model Bookmark {
  id           String      @id @default(cuid())
  userId       String
  postId       String?
  discussionId String?
  createdAt    DateTime    @default(now())
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  post         Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Bookmark_userId_fkey")
  @@index([postId], map: "Bookmark_postId_fkey")
  @@index([discussionId], map: "Bookmark_discussionId_fkey")
}



model DiscussionRoom {
  id           String    @id @default(cuid())
  title        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    User      @relation("CreatedRooms", fields: [creatorId], references: [id])
  creatorId    String
  messages     Message[]
  participants User[]    @relation("RoomParticipants")

  @@index([creatorId], map: "DiscussionRoom_creatorId_fkey")
}

model Message {
  id        String         @id @default(cuid())
  text      String
  createdAt DateTime       @default(now())
  room      DiscussionRoom @relation(fields: [roomId], references: [id])
  roomId    String
  author    User           @relation(fields: [authorId], references: [id])
  authorId  String

  @@index([authorId], map: "Message_authorId_fkey")
  @@index([roomId], map: "Message_roomId_fkey")
}
